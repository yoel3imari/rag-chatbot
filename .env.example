# RAG Chatbot configuration for docker compose.
# Copy to .env and adjust. Every value is optional — the app has defaults.

# --- LLM defaults (also editable in the UI) ---------------------------------
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Provider API keys ------------------------------------------------------
# Only the key matching LLM_PROVIDER is used by default. Keys entered in the UI
# are stored encrypted in the data volume instead.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# CUSTOM_LLM_API_KEY=

# --- Secrets ----------------------------------------------------------------
# Stable AES-256-GCM master key for credentials stored at rest.
# Recommended in prod: openssl rand -hex 32
# If unset, a key file is generated at /app/data/.secret_key.
# RAG_SECRET_KEY=

# --- Host / container -------------------------------------------------------
# APP_BIND=127.0.0.1
# APP_PORT=8000
# APP_UID=1000
# APP_GID=1000

# --- Limits & model ---------------------------------------------------------
# RAG_MAX_UPLOAD_MB=20
# EMBEDDING_MODEL=all-MiniLM-L6-v2
